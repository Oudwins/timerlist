{
  "expo": {
    "name": "Timerlist",
    "slug": "timerlist",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/brand/icon.png",
    "scheme": "timerlist",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#28211D",
    "ios": {
      "bundleIdentifier": "com.oudwins.timerlist",
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#211D1A",
        "foregroundImage": "./assets/brand/adaptive-icon.png",
        "monochromeImage": "./assets/brand/monochrome-icon.png"
      },
      "package": "com.oudwins.timerlist",
      "versionCode": 1,
      "permissions": [
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.USE_EXACT_ALARM"
      ],
      "predictiveBackGestureEnabled": true
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/brand/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#28211D",
          "image": "./assets/brand/adaptive-icon.png",
          "imageWidth": 180
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": false
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#FF5722",
          "sounds": [
            "./assets/sounds/beep.wav",
            "./assets/sounds/chime.wav",
            "./assets/sounds/bell.wav"
          ],
          "enableRemoteNotifications": false
        }
      ],
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
